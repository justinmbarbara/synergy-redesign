---
import Section from "./Section.astro";
import CopyBlock from "./CopyBlock.astro";
import HighlightCard from "./HighlightCard.astro";

const { background, section_id, kicker, heading, body, buttons = [], card = {} } = Astro.props;
---
<Section background={background} section_id={section_id}>
  <div class="container split">
    <CopyBlock kicker={kicker} heading={heading} body={body} buttons={buttons} class="copy reveal" />
    <HighlightCard card={card} class="sector-card reveal delay-1" />
  </div>
</Section>
