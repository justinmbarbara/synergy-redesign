---
import { mdInline, delayClass } from "../../lib/markdown";
import { linkAttrs } from "../../lib/links";
import Section from "./Section.astro";
import SectionHead from "./SectionHead.astro";

const { background, section_id, kicker, heading, lede, centered = true, cards = [], footnote } = Astro.props;
---
<Section background={background} section_id={section_id}>
  <div class="container">
    <SectionHead kicker={kicker} heading={heading} lede={lede} center={centered} />
    <div class="team-levels" data-editable="array" data-prop="cards" data-direction="row">
      {cards.map((card: any, index: number) => (
        <article class={`level-card reveal${delayClass(index, 3)}`} data-editable="array-item">
          <h3 set:html={mdInline(card.heading)} />
          <p set:html={mdInline(card.body)} />
        </article>
      ))}
    </div>
    {footnote?.text_before && (
      <p style="margin-top:30px;text-align:center;color:var(--muted)">{footnote.text_before}{footnote.link?.text && <a style="color:var(--blue-dark);font-weight:700" {...linkAttrs(footnote.link)}>{footnote.link.text}</a>}{footnote.text_after}</p>
    )}
  </div>
</Section>
