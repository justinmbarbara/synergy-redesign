---
/**
 * Homepage tombstone grid. The transactions themselves come from
 * data/tombstones.yml - anything with "Show on homepage" switched on - so
 * there is a single source of truth for transaction data.
 */
import Section from "./Section.astro";
import SectionHead from "./SectionHead.astro";
import Buttons from "./Buttons.astro";
import { buildFeaturedCards } from "../../lib/transactions";

const {
  background,
  section_id,
  kicker,
  heading,
  lede,
  centered = true,
  alt_suffix = "representative Synergy Advisors healthcare transaction",
  limit = 4,
  buttons = [],
} = Astro.props;

const cards = buildFeaturedCards(limit);
---
<Section background={background} section_id={section_id}>
  <div class="container">
    <SectionHead kicker={kicker} heading={heading} lede={lede} center={centered} />
    <div class="deal-grid">
      {cards.map((card) => (
        <article class="deal-card tombstone-card">
          <img src={card.image} alt={`${card.alt} - ${alt_suffix}`} loading="lazy" />
        </article>
      ))}
    </div>
    <Buttons buttons={buttons} style="margin-top:34px;text-align:center" />
  </div>
</Section>
